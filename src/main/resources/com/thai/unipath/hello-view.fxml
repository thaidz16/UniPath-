                                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #fcfcfc; -fx-padding: 8; -fx-border-color: #ecf0f1; -fx-border-radius: 8;">
                                                    <children>
                                                        <Label fx:id="lblCountHp" text="0 Kết quả" textFill="#f39c12"><font><Font name="System Bold" size="16.0" /></font></Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <ComboBox fx:id="cbSortHp" prefHeight="35.0" prefWidth="220.0" promptText="Học phí thấp -&gt; cao" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                                                        <TextField fx:id="txtSearchHp" prefHeight="35.0" prefWidth="250.0" promptText="🔍 Tìm ngành: nhập tên, mã..." style="-fx-background-radius: 5;" />
                                                    </children>
                                                </HBox>
                                                <TableView fx:id="tableHp" prefHeight="300.0" style="-fx-font-size: 14px; -fx-border-color: transparent;" VBox.vgrow="ALWAYS" />
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                            </tabs>
                        </TabPane>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>

    <Button fx:id="btnCallBot" text="🤖 Chat với UniBot" onAction="#toggleChatWindow" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" prefHeight="45.0" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" />

    <VBox fx:id="chatWindow" visible="false" AnchorPane.bottomAnchor="90.0" AnchorPane.rightAnchor="30.0" prefWidth="360.0" prefHeight="500.0" spacing="0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 8);">

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #d35400; -fx-padding: 12 15; -fx-background-radius: 15 15 0 0;">
            <children>
                <Label text="🤖 UniBot Tư Vấn" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-cursor: hand;" text="🟢 Online" textFill="#2ecc71"><font><Font name="System Bold" size="12.0" /></font></Label>
                <Region prefWidth="15.0" />
                <Button text="✖" onAction="#toggleChatWindow" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 0;" />
            </children>
        </HBox>

        <ScrollPane fx:id="scrollChat" fitToWidth="true" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: #f8f9fa;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="boxChatHistory" spacing="15.0" style="-fx-padding: 15;" />
            </content>
        </ScrollPane>

        <HBox spacing="10.0" alignment="CENTER" style="-fx-padding: 12; -fx-background-color: white; -fx-background-radius: 0 0 15 15; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
            <children>
                <TextField fx:id="txtChatInput" onAction="#onSendChatClick" HBox.hgrow="ALWAYS" prefHeight="40.0" promptText="Nhập điểm hoặc hỏi ngành..." style="-fx-background-radius: 20; -fx-border-color: #bdc3c7; -fx-border-radius: 20; -fx-padding: 0 15;" />
                <Button onAction="#onSendChatClick" prefHeight="40.0" prefWidth="70.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Gửi 🚀" />
            </children>
        </HBox>

    </VBox>
</AnchorPane>